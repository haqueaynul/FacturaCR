# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT="3000"

# ENCRYPTION_SECRET: Master key for AES-256-GCM Cryptographic Vault
# Used by scrypt derivation to encrypt taxpayer passwords, .p12 keys, and sensitive financial records.
ENCRYPTION_SECRET="CR_HACIENDA_VAULT_KEY_2026_SUPER_SECRET"

# HACIENDA_IDP_URL: Ministerio de Hacienda Keycloak IDP OAuth2 Token Endpoint
# Sandbox / Staging: https://idp.comprobanteselectronicos.go.cr/auth/realms/rut-stag/protocol/openid-connect/token
# Production:        https://idp.comprobanteselectronicos.go.cr/auth/realms/rut/protocol/openid-connect/token
HACIENDA_IDP_URL="https://idp.comprobanteselectronicos.go.cr/auth/realms/rut-stag/protocol/openid-connect/token"

# HACIENDA_API_URL: Ministerio de Hacienda Electronic Invoicing API Endpoint
# Sandbox / Staging: https://api.comprobanteselectronicos.go.cr/recepcion-sandbox/v1/
# Production:        https://api.comprobanteselectronicos.go.cr/recepcion/v1/
HACIENDA_API_URL="https://api.comprobanteselectronicos.go.cr/recepcion-sandbox/v1/"

# QR_VERIFICATION_URL: Official QR code verification base URL
# Used to generate compliant QR codes containing the 50-digit Clave, taxpayer ID, and total.
QR_VERIFICATION_URL="https://tribunet.hacienda.go.cr/docs/"
